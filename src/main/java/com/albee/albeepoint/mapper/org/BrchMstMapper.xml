    <select id="selectSeqBrchMstNo"         
        parameterType="com.albee.albeepoint.api.org.dto.OrgSearchDto"  
        resultType="java.lang.Long">
        SELECT COALESCE(MAX(BRCH_NO), 10000) + 1
          FROM T_BRCH_MST
         WHERE ORG_NO = #{orgNo};
    </select>

